{
  "build": {
    "arduino": {
      "ldscript": "esp32s3_out.ld",
      "partitions": "default_16MB.csv",
      "memory_type": "qio_opi"
    },
    "core": "esp32",
    "extra_flags": [
      "-DARDUINO_ESP32S3_DEV",
      "-DBOARD_HAS_PSRAM",
      "-DARDUINO_USB_CDC_ON_BOOT=1",
      "-DARDUINO_USB_MODE=0",
      "-mfix-esp32-psram-cache-issue"
    ],
    "mcu": "esp32s3",
    "variant": "esp32_s3r8n16",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio"
  },
  "connectivity": ["wifi", "bluetooth"],
  "debug": {
    "default_tool": "esp-builtin",
    "onboard_tools": [
      "esp-builtin"
    ],
    "openocd_target": "esp32s3.cfg"
  },
  "frameworks": ["arduino", "espidf"],
  "name": "Waveshare ESP32-S3-Touch-LCD-4",
  "upload": {
    "flash_size": "16MB",
    "maximum_ram_size": 16777216,
    "maximum_size": 16777216,
    "require_upload_port": true,
    "speed": 921600
  },
  "url": "https://www.waveshare.com/wiki/ESP32-S3-Touch-LCD-4",
  "vendor": "Waveshare"
}
